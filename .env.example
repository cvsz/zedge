# --- required -------------------------------------------------------------
# Cloudflare API token used by the server. It never reaches the browser.
CLOUDFLARE_API_TOKEN=

# Creates the first user, "admin", when no users exist yet (12+ characters).
# After that, manage users under Users & Roles.
ZEDGE_ADMIN_PASSWORD=

# --- recommended ----------------------------------------------------------
# One account id, or several separated by commas to restrict the console.
# Leave both empty to use every account the token can see.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ACCOUNT_IDS=

# Random string that signs session cookies. If unset, a new one is generated
# at every start (everyone is signed out on restart).
SESSION_SECRET=

# --- R2 object browsing and uploads (optional) ----------------------------
# An R2 access key pair (dashboard: R2 > Manage API tokens). Not the same as CLOUDFLARE_API_TOKEN.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Defaults to https://<account id>.r2.cloudflarestorage.com
R2_ENDPOINT=
R2_MAX_UPLOAD_MB=50

# --- optional -------------------------------------------------------------
HOST=127.0.0.1
PORT=8787
SESSION_HOURS=12
# Where users, roles and the audit log are stored.
DATA_DIR=./data
# Set to 1 when serving over HTTPS (required if HOST is not loopback).
COOKIE_SECURE=0
# Set to 1 only when a Cloudflare Tunnel is the sole way in: uses the real client IP.
TRUST_CF_CONNECTING_IP=0
# Loopback-only escape hatch for local use without a password (only if there are no users).
ZEDGE_ALLOW_NO_AUTH=0
# Override only for testing.
CF_API_BASE=https://api.cloudflare.com/client/v4

# --- operations (all optional) ---------------------------------------------
# Per-user API limits per minute (reads and writes counted separately).
RATE_LIMIT_PER_MIN=600
RATE_LIMIT_WRITES_PER_MIN=120
# 1 = risky actions need a second person with the approvals.decide permission.
APPROVAL_REQUIRED=0
# Enables GET /metrics for Prometheus (send "Authorization: Bearer <token>"). 16+ characters. Off when empty.
METRICS_TOKEN=
# Slack-compatible webhook: gets one line ("user METHOD path") for every successful change. https only.
ALERT_WEBHOOK_URL=
# Delete console audit entries older than this many days at startup (0 keeps everything).
AUDIT_RETENTION_DAYS=0
# Encrypts `npm run backup -- create` archives.
BACKUP_PASSPHRASE=

# --- single sign-on (OpenID Connect), optional -------------------------------
# Works with any OIDC provider (Google, Microsoft Entra, Okta, Keycloak, Cloudflare Access as IdP...).
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Must match what you registered at the provider; https (or loopback for testing).
OIDC_REDIRECT_URL=
# Which claim carries groups, and which value maps to which console role (first match in this order wins).
OIDC_ROLE_CLAIM=groups
OIDC_ROLE_MAP={"zedge-admins":"admin","zedge-ops":"operator"}
OIDC_DEFAULT_ROLE=viewer
# Only these email domains may sign in (empty = any the provider allows).
OIDC_ALLOWED_DOMAINS=
# 1 = no password sign-in, except the break-glass users below.
OIDC_DISABLE_PASSWORD=0
OIDC_BREAKGLASS_USERS=admin

# --- email alerts, optional ----------------------------------------------------
# smtps://user:pass@host:465  or  smtp://user:pass@host:587 (STARTTLS). Plain SMTP only to loopback.
SMTP_URL=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=
# Cloudflare failures in 5 minutes before an alert; days before token expiry to warn.
ALERT_CF_ERRORS=10
ALERT_TOKEN_WARN_DAYS=14

# --- written by `npm run deploy` -------------------------------------------
TUNNEL_TOKEN=
