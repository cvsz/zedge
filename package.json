{
  "name": "zedge",
  "version": "2.0.1",
  "description": "Self-hosted Cloudflare control panel: domains, DNS, security, rules, Workers, Pages, load balancing, KV/D1, R2, Zero Trust, email, analytics, snapshots, multi-user roles",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node server/index.js",
    "test": "node test/run.mjs",
    "deploy": "node scripts/deploy.mjs",
    "smoke": "node test/ui-smoke.mjs",
    "backup": "node scripts/backup.mjs",
    "openapi": "node scripts/openapi.mjs",
    "openapi:check": "node scripts/openapi.mjs --check",
    "typecheck": "tsc -p .",
    "sbom": "node scripts/sbom.mjs package-lock.json --out sbom.json",
    "rotate": "node scripts/rotate.mjs"
  },
  "dependencies": {
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "axe-core": "^4.14.0",
    "typescript": "^5.9.3"
  }
}
